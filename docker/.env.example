# Copy to docker/.env — read by compose.yaml

OPTIONSTRAT_EMAIL=you@example.com
OPTIONSTRAT_PASSWORD=yourpassword
OPTIONSTRAT_ACCOUNT_ID=your-account-uuid

# publish.sh uploads to S3 and invalidates CloudFront. The key needs s3:ListBucket,
# s3:PutObject and s3:DeleteObject on the bucket, and cloudfront:CreateInvalidation.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Optional overrides
# S3_BUCKET=optionspread-heatmaps-billbaran
# CLOUDFRONT_DISTRIBUTION_ID=E3AR100VQDUFIT

# Absolute path, on the Docker host, of the directory shared with equity-watch. It writes
# betas.json there and reads underlyings.txt. It must exist, be owned by uid 1000 and
# be the same directory as equity-watch's SHARED_DIR.
SHARED_DIR=/path/on/docker/host/equity-shared

# Paper trades (paper.js): spread-book's own read-only tastytrade OAuth client, not spread-scanner's.
# Without these the paper jobs do nothing. See the README, "Paper trades".
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
# TASTYTRADE_CLIENT_ID=

# The ticket watcher (ticket-watch.js, the spread-book-tickets service): spread-scanner's ticket queue and the
# watcher's own keys, from that stack's outputs (EnableTickets=true). TICKETS_BUCKET is the scanner's bucket,
# where each ticket's result goes for its page. Without these the watcher idles.
TICKETS_QUEUE_URL=
TICKETS_BUCKET=
TICKETS_AWS_ACCESS_KEY_ID=
TICKETS_AWS_SECRET_ACCESS_KEY=
# TICKETS_REGION=us-east-1
